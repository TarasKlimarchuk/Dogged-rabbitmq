{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/terminal",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/terminal/tsconfig.app.json"
  },
  "sourceRoot": "apps/terminal/src",
  "projects": {
    "terminal": {
      "type": "application",
      "root": "apps/terminal",
      "entryFile": "main",
      "sourceRoot": "apps/terminal/src",
      "compilerOptions": {
        "tsConfigPath": "apps/terminal/tsconfig.app.json",
        "builder": "rspack"
      }
    },
    "orders-management": {
      "type": "application",
      "root": "apps/orders-management",
      "entryFile": "main",
      "sourceRoot": "apps/orders-management/src",
      "compilerOptions": {
        "tsConfigPath": "apps/orders-management/tsconfig.app.json",
        "builder": "rspack"
      }
    },
    "warehouse": {
      "type": "application",
      "root": "apps/warehouse",
      "entryFile": "main",
      "sourceRoot": "apps/warehouse/src",
      "compilerOptions": {
        "tsConfigPath": "apps/warehouse/tsconfig.app.json",
        "builder": "rspack"
      }
    },
    "resilience": {
      "type": "library",
      "root": "libs/resilience",
      "entryFile": "index",
      "sourceRoot": "libs/resilience/src",
      "compilerOptions": {
        "tsConfigPath": "libs/resilience/tsconfig.lib.json"
      }
    },
    "metrics": {
      "type": "library",
      "root": "libs/metrics",
      "entryFile": "index",
      "sourceRoot": "libs/metrics/src",
      "compilerOptions": {
        "tsConfigPath": "libs/metrics/tsconfig.lib.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "orders-worker": {
      "type": "application",
      "root": "apps/orders-worker",
      "entryFile": "main",
      "sourceRoot": "apps/orders-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/orders-worker/tsconfig.app.json",
        "builder": "rspack"
      }
    },
    "utils": {
      "type": "library",
      "root": "libs/utils",
      "entryFile": "index",
      "sourceRoot": "libs/utils/src",
      "compilerOptions": {
        "tsConfigPath": "libs/utils/tsconfig.lib.json"
      }
    },
    "orders-db": {
      "type": "library",
      "root": "libs/orders-db",
      "entryFile": "index",
      "sourceRoot": "libs/orders-db/src",
      "compilerOptions": {
        "tsConfigPath": "libs/orders-db/tsconfig.lib.json"
      }
    },
    "warehouse-db": {
      "type": "library",
      "root": "libs/warehouse-db",
      "entryFile": "index",
      "sourceRoot": "libs/warehouse-db/src",
      "compilerOptions": {
        "tsConfigPath": "libs/warehouse-db/tsconfig.lib.json"
      }
    },
    "restock-request-consumer": {
      "type": "application",
      "root": "apps/restock-request-consumer",
      "entryFile": "main",
      "sourceRoot": "apps/restock-request-consumer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/restock-request-consumer/tsconfig.app.json",
        "builder": "rspack"
      }
    },
    "outbox": {
      "type": "library",
      "root": "libs/outbox",
      "entryFile": "index",
      "sourceRoot": "libs/outbox/src",
      "compilerOptions": {
        "tsConfigPath": "libs/outbox/tsconfig.lib.json"
      }
    }
  }
}
